+static void test_analysis_hints() {
+    // An unresolved `jr a0` at the entry, two switch cases after it and a
+    // function nothing references. Only hints can reach the last three.
+    auto bytes = make_function_pointer_test_elf();
+    const std::uint32_t code[] = {
+        0x00800008u, // 0x08804000: jr a0
+        0x00000000u, // nop
+        0x24020001u, // 0x08804008: case 0: addiu v0, zero, 1
+        0x03E00008u, // jr ra
+        0x00000000u, // nop
+        0x24020002u, // 0x08804014: case 1: addiu v0, zero, 2
+        0x03E00008u, // jr ra
+        0x00000000u, // nop
+        0x24020003u, // 0x08804020: unreferenced function
+        0x03E00008u, // jr ra
+        0x00000000u, // nop
+        0x00000000u,
+    };
+    for (std::size_t i = 0; i < std::size(code); ++i) put32(bytes, 0x80u + i * 4u, code[i]);
+    auto elf = psprecomp::Elf32Image::from_bytes(bytes, "analysis_hints.elf");
+    psprecomp::GuestMemory memory;
+    (void)elf.load_and_relocate(memory, psprecomp::kDefaultPspUserLoadBase);
+
+    const auto plain = psprecomp::analyze_program(elf, memory, psprecomp::kDefaultPspUserLoadBase);
+    require(!plain.covered_labels.contains(0x08804008u) && !plain.covered_labels.contains(0x08804020u),
+            "Hint test ELF is reachable without hints");
+
+    const auto root = std::filesystem::temp_directory_path() / "psprecomp_analysis_hints_test";
+    std::filesystem::remove_all(root);
+    std::filesystem::create_directories(root);
+    const auto hints_path = root / "hints.txt";
+    {
+        std::ofstream out(hints_path);
+        out << "# generated by a disassembler\n"
+            << "code 0x08804000 0x0880402C\n"
+            << "seed 08804020 test  # unreferenced\n"
+            << "jumptable 0x08804000 0x08804008 0x08804014\n";
+    }
+    const auto hints = psprecomp::load_analysis_hints(hints_path);
+    require(hints.code_ranges.size() == 1u && hints.seeds.size() == 1u && hints.jump_tables.size() == 1u,
+            "Analysis hints were not parsed");
+    const auto program = psprecomp::analyze_program(elf, memory, psprecomp::kDefaultPspUserLoadBase, hints);
+    const auto seed = program.seeds.find(0x08804020u);
+    require(seed != program.seeds.end() && seed->second == "test", "Hint seed was not added with its source");
+    require(program.covered_labels.contains(0x08804020u), "Hint seed was not analyzed");
+    require(program.covered_entry_labels.contains(0x08804008u) &&
+                program.covered_entry_labels.contains(0x08804014u),
+            "Jump table targets did not become dispatcher entries");
+    require(program.functions.front().entry == 0x08804000u &&
+                program.functions.front().labels.contains(0x08804014u),
+            "Jump table targets were not owned by the function with the jr");
+    require(program.executable_ranges.size() == 1u && program.executable_ranges.front().end == 0x0880402Cu,
+            "Hint code ranges did not replace the segment ranges");
+
+    {
+        std::ofstream out(hints_path);
+        out << "seed nothex\n";
+    }
+    bool rejected = false;
+    try {
+        (void)psprecomp::load_analysis_hints(hints_path);
+    } catch (const psprecomp::Error &) {
+        rejected = true;
+    }
+    require(rejected, "Malformed analysis hints were accepted");
+    std::filesystem::remove_all(root);
+}
