#
# The VFPU lookup tables of PPSSPP (assets/vfpu/*.dat), which mpo_vfpu needs
# to reproduce vsin/vcos/vrsq/vsqrt/vasin/vexp2/vlog2/vrcp bit for bit. They
# are data generated by PPSSPP from PSP measurements (GPL-2.0-or-later) and
# weigh about 5 MB, so they are fetched at configure time instead of being
# committed. See NOTICE.md.
#
# Defines, when MPO_FETCH_VFPU_TABLES is ON:
#   MPO_VFPU_TABLES_DIR  directory with the 15 .dat files

include(${CMAKE_CURRENT_LIST_DIR}/ppsspp_fetch.cmake)

option(MPO_FETCH_VFPU_TABLES "Fetch the PPSSPP VFPU tables (assets/vfpu) at configure time" ON)

set(MPO_VFPU_TABLES_DIR "")
